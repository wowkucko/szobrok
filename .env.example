[TEMPLATE]
# Admin védelem — két módszer (mindkettő élhet egyszerre, OR kapcsolatban)
# 1) Google OAuth (elsődleges) — csak az ADMIN_EMAILS listán lévők léphetnek be
#    Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#    Authorized redirect URIs: https://festettszobrok.com/api/auth/callback/google és http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# vesszővel elválasztva, kisbetűsítve ellenőrzi. Példa: "festettszobrokmuhelye@gmail.com,masik@gmail.com"
ADMIN_EMAILS=festettszobrokmuhelye@gmail.com
# Auth.js titok (kötelező ha Google-t használsz). Generálás: openssl rand -base64 32
AUTH_SECRET=
# Opcionális: explicit URL (ha proxy mögött vagy, különben automatikus)
# AUTH_URL=https://festettszobrok.com

# 2) Fallback Basic Auth (megmarad) — böngésző felugró ablak az /admin és /api/admin útvonalakon
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google Search Console verifikacio (meta tag modszer)
# A Google altal adott token. Build utan eletszik (NEXT_PUBLIC_*).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Nyilvános weboldal címe (canonical, sitemap, feed, OG meta — mindenhol ez megy)
NEXT_PUBLIC_SITE_URL=https://festettszobrok.com

# MailerLite hírlevél (a tokent a MailerLite fiók: Integrations -> MailerLite API -> Generate new token)
MAILERLITE_API_TOKEN=
# Opcionális: annak a csoportnak az ID-ja, amelybe a feliratkozók kerülnek
# (a csoportok oldal URL-jében találod, pl. .../groups/4243829086487936)
MAILERLITE_GROUP_ID=
