# Admin védelem (az /admin oldalhoz)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── E-mail küldés (egyedi ajánlatkérés űrlap) ─────────────────────────────
# SMTP szerver adatai (pl. a tárhelyszolgáltatód mail szervere):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Feladó és címzett (alapértelmezett címzett: ajanlatkeres@festettszobrok.com)
MAIL_FROM=
MAIL_TO=ajanlatkeres@festettszobrok.com

# Google Search Console verifikacio (meta tag modszer)
# A Google altal adott token. Build utan eletszik (NEXT_PUBLIC_*).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Nyilvános weboldal címe (canonical, sitemap, feed, OG meta — mindenhol ez megy)
NEXT_PUBLIC_SITE_URL=https://festettszobrok.com
